# Auxesis Capital: server settings. Copy to .env (start.sh does this for you) and fill in.

# ---- Where it runs ----
# Public URL of the site (no trailing slash). Google redirects back to APP_URL/auth/callback.
APP_URL=https://students.iima.ac.in/auxesiscapital
# Sub-path Apache forwards to this server (must match APP_URL's path).
BASE_PATH=/auxesiscapital/
# Port Apache proxies to (garba2026 uses 8090).
PORT=8091
# 127.0.0.1 when Apache is on this machine; 0.0.0.0 when Apache runs on another server.
HOST=127.0.0.1
# Where the database, uploaded PDFs and photos live. Back this folder up.
DATA_DIR=./data
# Apache sends the real visitor IP in this header.
TRUSTED_PROXY_HEADERS=X-Forwarded-For

# ---- Who gets in ----
# Investors sign in with the Google account whose email is on the investor list (dashboard → investors).
# These people are fund admins: they see the Admin page (sync, upload, reconciliation). Comma separated.
ADMIN_EMAILS=

# ---- Google sign-in (required) ----
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorised redirect URI:  https://students.iima.ac.in/auxesiscapital/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- The tracker ----
# OneDrive/SharePoint sharing link to the tracker .xlsx. It must be shared as
# "Anyone with the link can view" for the server to download it; otherwise leave it empty
# and upload the file on the Admin page after each day's trades.
EXCEL_URL=
# Sheet with the trade log. Empty: the first sheet with a "Trade ID" header row.
TRADES_SHEET=Overall Fund
# When to pull the tracker and the day's closing prices (IST, cron). "off" to disable.
SYNC_CRON=10 16,19,22 * * 1-5
# Daily closes from Yahoo Finance for NAV history and the Nifty 50 / 500. "off" to disable.
PRICE_HISTORY=on

# ---- PocketBase dashboard login (optional) ----
# If set, start.sh creates/updates this superuser. Dashboard: https://students.iima.ac.in/auxesiscapital/_/
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=
