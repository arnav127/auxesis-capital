{
  "name": "auxesis-capital",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "backend": "cd backend && go run . serve",
    "backend:build": "cd backend && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o auxesis-server .",
    "backend:test": "cd backend && go test ./...",
    "seed": "cd backend && go run . seed"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "pocketbase": "^0.28.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
